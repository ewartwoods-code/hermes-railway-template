# syntax=docker/dockerfile:1

# Keep the release tag human-readable and the multi-platform digest immutable.
# Dependabot opens an update PR when Nous Research publishes a newer image.
FROM nousresearch/hermes-agent:v2026.8.3@sha256:16788311e2fa3035456bdc1bafb8ec2b1777db64ebf020af9bb7eb73c3712c9e

LABEL org.opencontainers.image.title="Hermes Agent for Railway" \
      org.opencontainers.image.description="Railway template built on the official Nous Research Hermes Agent image" \
      org.opencontainers.image.source="https://github.com/otopba/hermes-railway-template" \
      org.opencontainers.image.licenses="MIT"

# These are non-secret hosted-container defaults. Authentication credentials
# are generated by the Railway template and must never be baked into the image.
ENV PORT=9119 \
    HERMES_DASHBOARD=1 \
    HERMES_DASHBOARD_HOST=0.0.0.0 \
    HERMES_DASHBOARD_PORT=9119 \
    API_SERVER_ENABLED=false

EXPOSE 9119

# Do not add ENTRYPOINT or CMD here. The upstream entrypoint owns PID 1,
# initializes /opt/data, drops privileges, and supervises gateway + dashboard.

# EWART WOODS - Hermione's web chat, connected to the farm (owner, 2026-10-07).
# 019-hermione runs at every boot before the profile reconciler: no gateway, cron or
# messaging platform starts by itself; her persona, settings and the read-only farm
# repository are installed. Farm scripts see her name; secrets stay Railway variables.
ENV FARM_WORKER=hermione \
    WORKER_ID=hermione
COPY hermione/SOUL.md /opt/hermione/SOUL.md
COPY --chmod=0755 hermione/019-hermione /etc/cont-init.d/019-hermione
